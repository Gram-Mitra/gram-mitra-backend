# Server Configuration
PORT=5000
NODE_ENV=development

# Application Info
APP_NAME=Gram Mitra Backend
API_VERSION=v1

# CORS Allowed Origins
CORS_ORIGIN=*

# Database / Supabase Configuration
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# JWT Secrets (Future Phase)
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Government Schemes API (data.gov.in)
DATA_GOV_API_KEY=your_data_gov_api_key_here
DATA_GOV_BASE_URL=https://api.data.gov.in/resource
DATA_GOV_RESOURCE_ID=388208c6-d82a-4190-90df-91aa2c326fec
DATA_GOV_CACHE_TTL_MS=600000

# Vapi AI Voice Agent (Mentor Call Section)
VAPI_PUBLIC_KEY=your_vapi_public_key_from_dashboard
VAPI_ASSISTANT_ID=your_vapi_assistant_id
VAPI_SERVER_SECRET=your_custom_webhook_secret_here
